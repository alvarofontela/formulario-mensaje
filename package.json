{
  "name": "formulario-mensaje",
  "private": true,
  "scripts": {
    "test:e2e": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/rt.ps1 e2e",
    "test:php": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/rt.ps1 phpunit",
    "build": "wp-scripts build --source-path=src --output-path=plugin/build",
    "start": "wp-scripts start --source-path=src --output-path=plugin/build",
    "lint:js": "wp-scripts lint-js src plugin/assets/js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@wordpress/scripts": "^35.0.0"
  }
}
