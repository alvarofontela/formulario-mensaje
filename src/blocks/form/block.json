{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "formulario-mensaje/form",
	"version": "0.7.0",
	"title": "Form",
	"category": "widgets",
	"icon": "feedback",
	"description": "Insert a form created with Formulario Mensaje.",
	"keywords": [ "form", "contact", "formulario" ],
	"textdomain": "formulario-mensaje",
	"attributes": {
		"formId": {
			"type": "integer",
			"default": 0
		},
		"formStyle": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true,
			"link": false
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "formulario-mensaje-form"
}
