  "visibility": [
    {
      "name": "sin condiciones se muestra todo",
      "conditions": {
        "a": {},
        "b": {}
      },
      "values": {},
      "expected": {
        "a": true,
        "b": true
      }
    },
    {
      "name": "un campo aparece cuando uno anterior tiene el valor",
      "conditions": {
        "tipo": {},
        "empresa": {
          "match": "all",
          "rules": [
            {
              "field": "tipo",
              "operator": "equals",
              "value": "empresa"
            }
          ]
        }
      },
      "values": {
        "tipo": "empresa",
        "empresa": "ACME"
      },
      "expected": {
        "tipo": true,
        "empresa": true
      }
    },
    {
      "name": "y se oculta cuando no lo tiene",
      "conditions": {
        "tipo": {},
        "empresa": {
          "match": "all",
          "rules": [
            {
              "field": "tipo",
              "operator": "equals",
              "value": "empresa"
            }
          ]
        }
      },
      "values": {
        "tipo": "particular",
        "empresa": "ACME"
      },
      "expected": {
        "tipo": true,
        "empresa": false
      }
    },
    {
      "name": "un campo oculto no aporta su valor al que depende de él",
      "conditions": {
        "tipo": {},
        "empresa": {
          "match": "all",
          "rules": [
            {
              "field": "tipo",
              "operator": "equals",
              "value": "empresa"
            }
          ]
        },
        "cif": {
          "match": "all",
          "rules": [
            {
              "field": "empresa",
              "operator": "is_not_empty",
              "value": ""
            }
          ]
        }
      },
      "values": {
        "tipo": "particular",
        "empresa": "ACME",
        "cif": "B123"
      },
      "expected": {
        "tipo": true,
        "empresa": false,
        "cif": false
      }
    },
    {
      "name": "un campo posterior cuenta como vacío aunque tenga valor",
      "conditions": {
        "cif": {
          "match": "all",
          "rules": [
            {
              "field": "empresa",
              "operator": "is_not_empty",
              "value": ""
            }
          ]
        },
        "empresa": {}
      },
      "values": {
        "empresa": "ACME",
        "cif": "B123"
      },
      "expected": {
        "cif": false,
        "empresa": true
      }
    },
    {
      "name": "dos campos que dependen el uno del otro se resuelven en el orden del formulario",
      "conditions": {
        "a": {
          "match": "all",
          "rules": [
            {
              "field": "b",
              "operator": "is_empty",
              "value": ""
            }
          ]
        },
        "b": {
          "match": "all",
          "rules": [
            {
              "field": "a",
              "operator": "is_empty",
              "value": ""
            }
          ]
        }
      },
      "values": {
        "a": "x",
        "b": "y"
      },
      "expected": {
        "a": true,
        "b": false
      }
    },
    {
      "name": "un elemento sin valor propio también puede tener condición",
      "conditions": {
        "tipo": {},
        "aviso": {
          "match": "any",
          "rules": [
            {
              "field": "tipo",
              "operator": "equals",
              "value": "urgente"
            },
            {
              "field": "tipo",
              "operator": "equals",
              "value": "crítico"
            }
          ]
        }
      },
      "values": {
        "tipo": "Urgente"
      },
      "expected": {
        "tipo": true,
        "aviso": true
      }
    },
    {
      "name": "los campos de un paso que no se muestra tampoco se muestran, ni aportan su valor",
      "conditions": {
        "tipo": {},
        "paso_empresa": {
          "match": "all",
          "rules": [
            {
              "field": "tipo",
              "operator": "equals",
              "value": "empresa"
            }
          ]
        },
        "empresa": {},
        "final": {
          "match": "all",
          "rules": [
            {
              "field": "empresa",
              "operator": "is_empty",
              "value": ""
            }
          ]
        }
      },
      "parents": {
        "empresa": "paso_empresa"
      },
      "values": {
        "tipo": "particular",
        "empresa": "ACME"
      },
      "expected": {
        "tipo": true,
        "paso_empresa": false,
        "empresa": false,
        "final": true
      }
    },
    {
      "name": "los campos de un paso que sí se muestra siguen su propia condición",
      "conditions": {
        "tipo": {},
        "paso_empresa": {
          "match": "all",
          "rules": [
            {
              "field": "tipo",
              "operator": "equals",
              "value": "empresa"
            }
          ]
        },
        "empresa": {},
        "cif": {
          "match": "all",
          "rules": [
            {
              "field": "empresa",
              "operator": "is_not_empty",
              "value": ""
            }
          ]
        }
      },
      "parents": {
        "empresa": "paso_empresa",
        "cif": "paso_empresa"
      },
      "values": {
        "tipo": "empresa",
        "empresa": "",
        "cif": "B123"
      },
      "expected": {
        "tipo": true,
        "paso_empresa": true,
        "empresa": true,
        "cif": false
      }
    }
  ]
}
