{
  "conditions": [
    {
      "name": "sin reglas se cumple",
      "condition": {
        "match": "all",
        "rules": []
      },
      "values": {},
      "expected": true
    },
    {
      "name": "condición vacía se cumple",
      "condition": {},
      "values": {
        "a": "x"
      },
      "expected": true
    },
    {
      "name": "es, sin distinguir mayúsculas ni espacios",
      "condition": {
        "match": "all",
        "rules": [
          {
            "field": "a",
            "operator": "equals",
            "value": "Ventas"
          }
        ]
      },
      "values": {
        "a": " ventas "
      },
      "expected": true
    },
    {
