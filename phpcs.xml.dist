<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="formulario-mensaje" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>Estándares de WordPress y compatibilidad con PHP 8.1+ para el código del plugin.</description>

	<file>plugin</file>

	<!-- Resultado de compilar src/ con @wordpress/scripts: se revisan los fuentes, no lo generado. -->
	<exclude-pattern>plugin/build/*</exclude-pattern>
	<!-- Traducciones generadas por `rt i18n`. -->
	<exclude-pattern>plugin/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value=".runtime/tmp/phpcs.cache"/>
	<arg value="sp"/>

	<!-- Versiones mínimas que soporta el plugin. -->
	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="formulario-mensaje"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="formulario_mensaje"/>
				<!-- El prefijo anterior cubre también el namespace Formulario_Mensaje: la comparación no distingue mayúsculas. -->
			</property>
		</properties>
	</rule>
</ruleset>
