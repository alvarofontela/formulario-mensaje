msgid "An SMTP server"
msgstr "Un servidor SMTP"

#: build/admin/index.js:23
msgid "Resend"
msgstr "Resend"

#: build/admin/index.js:23
msgid "Server"
msgstr "Servidor"

#: build/admin/index.js:23
msgid "Port"
msgstr "Puerto"

#: build/admin/index.js:23
