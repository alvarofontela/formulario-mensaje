msgstr "Clave de API de Resend"

#: build/admin/index.js:23
msgid "Resend only sends from an address of a domain verified in your Resend account: fill in the sender address below."
msgstr "Resend solo envía desde una dirección de un dominio verificado en tu cuenta de Resend: rellena abajo la dirección del remitente."

#: build/admin/index.js:23
msgid "Sender address"
msgstr "Dirección del remitente"

#: build/admin/index.js:23
