msgstr "Vacío para usar la del sitio."

#: build/admin/index.js:23
msgid "Sender name"
msgstr "Nombre del remitente"

#: build/admin/index.js:23
msgid "Empty to use the name of the site."
msgstr "Vacío para usar el nombre del sitio."

