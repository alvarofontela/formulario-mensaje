msgstr "Enviar un correo de prueba a"

#: build/admin/index.js:23
msgid "Save the settings first: the test uses the saved ones."
msgstr "Guarda primero los ajustes: la prueba usa los guardados."

#: build/admin/index.js:23
msgid "Checks that the emails are delivered with these settings."
msgstr "Comprueba que los correos se entregan con estos ajustes."

#: build/admin/index.js:24
msgid "Email appearance"
msgstr "Aspecto de los correos"

#: build/admin/index.js:24
msgid "Brand of the notifications sent in HTML format."
msgstr "Marca de las notificaciones que se envían en formato HTML."

