msgstr "Cifrado"

#: build/admin/index.js:23
msgid "STARTTLS (usually port 587)"
msgstr "STARTTLS (normalmente, puerto 587)"

#: build/admin/index.js:23
msgid "SSL/TLS (usually port 465)"
msgstr "SSL/TLS (normalmente, puerto 465)"

