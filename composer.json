{
    "name": "local/formulario-mensaje",
    "description": "Plugin de formularios para WordPress",
    "type": "wordpress-plugin",
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^3.0@dev",
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0@dev"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=8.1"
    }
}
